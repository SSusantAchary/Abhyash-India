# Copy to .env.local in this directory. Never prefix secrets with NEXT_PUBLIC_.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
MURF_API_KEY=

# Required with npm start / production. Enter this in Connection setup.
ABHYASH_ACCESS_CODE=

# Optional: default is Agora-managed OpenAI gpt-4o-mini (enable managed access).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini

# Persistent single-host directory, shared across all app workers.
# ABHYASH_DATA_DIR=/absolute/path/to/persistent/abhyash-data

# Only needed for the inherited recording + analytics backend.
NEXT_PUBLIC_API_URL=http://localhost:8100

# For a deployed agent-tool callback origin. Local demos discover npm run tools:dev automatically.
# ABHYASH_TOOLS_BASE_URL=https://your-deployed-app.example.com
